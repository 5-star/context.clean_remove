<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="context.clean_remove" name="Clean Remove" version="7.5.2" provider-name="Luis Rodrigues">
	<extension point="kodi.context.item">
		<menu id="kodi.core.main">
			<item library="addon.py">
				<label>30001</label>
				<visible>!String.IsEmpty(ListItem.VideoCodec) | ListItem.IsFolder + !String.IsEmpty(ListItem.Path) + !String.Contains(Listitem.Path,://) + !String.IsEqual(ListItem.DBTYPE,season)</visible>
			</item>
		</menu>
	</extension>
	<extension point="kodi.context.item" library="addon.py">
		<item library="movie" label="30001"/>
		<item library="tvshow" label="30001"/>
		<item library="episode" label="30001"/>
		<item library="musicvideo" label="30001"/>
		<item library="video" label="30001"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Clean Remove</summary>
		<summary lang="lt_LT">Pilnai Pašalinti</summary>
		<description lang="en_GB">Removes item from library and disk, together with fanart and subtitles. No more orphan files left behind after Remove from library</description>
		<disclaimer lang="en_GB"></disclaimer>
		<description lang="lt_LT">Ištrina iš bibliotekos ir disko ne tik video failus, bet ir plakatus su subtitrais. Nebelieka pašalinių failų po trynimo.</description>
		<language></language>
		<platform>all</platform>
		<license>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</license>
		<source>https://github.com/5-star/context.clean_remove</source>
		<assets>
			<icon>icon.png</icon>
		</assets>
	</extension>
</addon>